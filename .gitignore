# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual env
.venv/
venv/
env/

# Streamlit
.streamlit/secrets.toml

# Local data — privacy-sensitive files never committed
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.json
data/*.csv
data/reports/
data/exports/
data/lead_exports/
data/lead_funnel_exports/
data/client_case_exports/
exports/
# Allow .gitkeep placeholders
!data/.gitkeep
!data/exports/.gitkeep
!data/lead_exports/.gitkeep
!data/lead_funnel_exports/.gitkeep
!data/client_case_exports/.gitkeep

# Secrets / credentials
.env
*.key
*.pem
*.token

# Logs
*.log

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Build
dist/
build/
*.egg-info/

# Generated outputs (not committed)
demo_outputs/
release/
!release/.gitkeep

# Demo seed data (generated by scripts/seed_demo_data.py — not committed)
data/demo_seed/
*.zip
*.rar
